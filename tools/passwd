#!/usr/bin/env bash
# Generate a salted BLAKE3 password record for the switch startup config.
# Prompt without echo on a terminal or read one password from stdin.
#
# Requires Bash 4 or later, basenc (GNU coreutils), and b3sum.

set -euo pipefail

export LC_ALL=C

if [[ ${1-} == blake3 ]]; then
    shift
fi

rounds=${1-42}
if (( $# > 2 )) || ! [[ $rounds =~ ^([1-9]|[1-5][0-9]|6[0-4])$ ]]; then
    echo "usage: tools/passwd [blake3] [iterations [8-hex-digit salt]]" >&2
    exit 1
fi

salt=${2-$(head -c 4 /dev/urandom | basenc --base16)}
[[ $salt =~ ^[[:xdigit:]]{8}$ ]] || { echo "invalid salt" >&2; exit 1; }

if [[ -t 0 ]]; then
    IFS= read -rs -p 'Switch password: ' input
    printf '\n' >&2
    password=$(printf %s "$input" | basenc --base16)
else
    # Hex encoding preserves NUL and line breaks so they can be rejected.
    password=$(head -c 23 | basenc --base16)
    if [[ $password == *0A ]]; then
        password=${password%0A}
        password=${password%0D}
    fi
fi

if (( ${#password} < 2 || ${#password} > 40 )) || [[ $password =~ ^(..)*(00|09|0[A-D]|20) ]]; then
    echo "expected 1-20 password bytes without NUL or ASCII whitespace" >&2
    exit 1
fi

digest=$salt$password
for ((i=0; i<rounds; i++)); do
    digest=$(printf %s "${digest^^}" | basenc --base16 -d | b3sum --no-names)
done

printf 'passwd blake3 %s %s %s\n' "$rounds" "${salt,,}" "${digest:0:32}"
